# Application Configuration
APP_NAME="Express Analytics RAG Assistant"
APP_ENV="development"
DEBUG=true
PORT=8000
HOST="0.0.0.0"

# Ingestion & Chunking Settings
DOCUMENTS_DIR="data/documents"
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# Vector Database (ChromaDB) Configuration
CHROMA_PERSIST_DIRECTORY="chroma_db"
CHROMA_COLLECTION_NAME="technical_documentation"

# Embedding Model Configuration
EMBEDDING_PROVIDER="gemini"
GEMINI_EMBEDDING_MODEL="models/text-embedding-004"
GEMINI_API_KEY="" # or GOOGLE_API_KEY

# LLM & Generation Configuration (Phase 4)
LLM_PROVIDER="gemini"
GEMINI_LLM_MODEL="gemini-1.5-flash"
MAX_RETRIES=2
TEMPERATURE=0.0

# Retrieval Configuration
DEFAULT_TOP_K=4
SIMILARITY_SCORE_THRESHOLD=0.0
