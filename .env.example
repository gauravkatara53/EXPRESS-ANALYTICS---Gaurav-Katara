# Application Configuration
APP_NAME="Express Analytics RAG Assistant"
APP_ENV="development"
DEBUG=true
PORT=8000
HOST="0.0.0.0"

# Ingestion & Chunking Settings
DOCUMENTS_DIR="data/documents"
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# LLM & Embedding Settings (Reserved for Future Phases)
# LLM_PROVIDER="groq" # or "google", "openai", "anthropic"
# GROQ_API_KEY="your-groq-api-key-here"
# GOOGLE_API_KEY="your-google-api-key-here"
# OPENAI_API_KEY="your-openai-api-key-here"
# VECTOR_STORE="chroma"
